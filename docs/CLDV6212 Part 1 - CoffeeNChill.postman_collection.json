                  "// The second request is meant to be sent AFTER an identical one already created\r\n// the same Category + Sku combo — that's what actually triggers the conflict\r\npm.test(\"Status code is 409 Conflict\", function () {\r\n    pm.response.to.have.status(409);\r\n});"
