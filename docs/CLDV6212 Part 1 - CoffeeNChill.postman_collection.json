    {
      "name": "Menu",
      "item": [
        {
          "name": "Create Menu Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response has Name and Price\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData).to.have.property('Name');\r\n    pm.expect(jsonData).to.have.property('Price');\r\n    pm.expect(jsonData.Price).to.be.a('number');\r\n    pm.expect(jsonData.Price).to.be.greaterThan(0);\r\n});\r\n\r\n// Capture this item's real Category and SKU so later requests\r\n// (like Update Menu Item) can reference a genuinely existing item\r\nvar created = pm.response.json();\r\npm.environment.set(\"lastCategory\", created.PartitionKey);\r\npm.environment.set(\"lastSku\", created.RowKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"Name\": \"Espresso\",\r\n  \"Description\": \"Double shot, strong and bold\",\r\n  \"Price\": 25.00,\r\n  \"Category\": \"Hot Drinks\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/menu?=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ],
              "query": [
                {
                  "key": "",
                  "value": "",
                  "description": "Creates a new coffee shop menu item. Request body and tests will be added when the local Functions app is available."
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Menu Item - Duplicate SKU (409)",
